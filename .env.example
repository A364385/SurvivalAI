# ---------------------------------------------------------------------------
# SurvivalAI local configuration (PAPER TRADING ONLY)
# Copy to `.env` and fill in only what you need. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Alpaca PAPER trading (paper keys only; live keys are ignored/refused) ---
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_API_SECRET=your_paper_api_secret_here
ALPACA_DATA_BASE_URL=https://data.alpaca.markets/v2
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets/v2

# --- News provider ---
NEWS_API_KEY=your_news_api_key_here

# --- System settings ---
ENVIRONMENT=PAPER

# --- Local LLM provider selection -------------------------------------------
# SURVIVALAI_LLM_PROVIDER = (empty) | lm_studio | ollama | gemini | claude
# Empty/unset => deterministic offline fallback (MockLLMProvider). The system
# is fully runnable with no LLM provider configured.
# SURVIVALAI_LLM_PROVIDER=lm_studio
# SURVIVALAI_LLM_ENDPOINT=http://127.0.0.1:1234
# SURVIVALAI_LLM_MODEL=your-local-model-name

# --- Optional remote LLM providers (costs are tracked, never posted anywhere) -
# Keys are read from the environment ONLY. They are never written to disk,
# never logged, and never returned by the dashboard API.
# GEMINI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Storage / runtime -------------------------------------------------------
# SURVIVALAI_DATA_DIR=./data
# SURVIVALAI_DASHBOARD_PORT=8099
