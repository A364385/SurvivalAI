# ---------------------------------------------------------------------------
# Runtime data, databases and model artifacts.
#
# These are regenerated by scripts/run_local.py, the dashboard and the
# training pipeline. The leading "/" is deliberate: app/data/ and
# app/core/models/ are SOURCE packages and must stay tracked.
# ---------------------------------------------------------------------------
/data/
/models/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
logs/

